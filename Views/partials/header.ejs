<header class="site-header">
  <div class="header-container">

    <a href="/" class="brand-logo" aria-label="Wildwood Park homepage">
      <img src="/images/logo.png" alt="Wildwood Park logo" class="brand-logo__image">
      <span class="brand-logo__text">
        Wildwood Park
      </span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="main-navigation"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav id="main-navigation" class="site-nav" aria-label="Main navigation">
      <ul class="nav-list">
        <li><a href="/">Home</a></li>
        <li><a href="/habitats">Habitats</a></li>
        <li><a href="/experiences">Experiences</a></li>
        <li><a href="/faq">FAQ</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </nav>

    <p class="opening-times">
      <span class="open-clock-icon">
        <%- include('./icons/clock') %>
      </span>
      <span>
        Open Daily
        <time datetime="09:00">9am</time>
        -
        <time datetime="18:00">6pm</time>
      </span>
    </p>

  </div>
</header>

<script src="/scripts/header.js"></script>
